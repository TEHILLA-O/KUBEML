{
  "title": "KubeML serving health",
  "uid": "kubeml-serving",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (slot) (rate(kubeml_inference_requests_total[1m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (slot) (rate(kubeml_inference_errors_total[1m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, slot) (rate(kubeml_inference_duration_seconds_bucket[5m])))", "refId": "A"}]
    }
  ]
}
